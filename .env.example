# App
JWT_SECRET=change-me-in-production
STORAGE_URL=./data
CRON_SECRET=change-me-cron-secret

# Database (JSON or SQLITE)
PERSISTENCE_MODE=JSON
# SQLITE_PATH=./data/expenses.sqlite
# SQLITE_BACKUP_INTERVAL_HOURS=6
# SQLITE_BACKUP_COUNT=5

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# Web Push (browser notifications in background)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:noreply@example.com
